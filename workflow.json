    {
      "id": "69cada1d-f2e3-423a-bdb7-dd7aad0f6c75",
      "name": "MD to HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        340
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const md = $json.bodyMd || '';\n\n// Split into paragraphs (blank-line separated)\nconst paras = md.split(/\\n{2,}/);\nlet html = paras.map(para => {\n  // Within a para, trailing-2-space or \\\\ = <br>\n  const inner = para\n    .replace(/  \\n/g, '<br>')\n    .replace(/\\\\\\n/g, '<br>')\n    .replace(/\\*\\*(.+?)\\*\\*/g, '<strong>$1</strong>')\n    .replace(/\\[([^\\]]+)\\]\\(([^)]+)\\)/g, '<a href=\"$2\">$1</a>')\n    .replace(/\\n/g, ' ');\n  return `<p>${inner}</p>`;\n}).join('\\n');\n\nreturn { ...$json, bodyHtml: html };\n"
      }
    },
