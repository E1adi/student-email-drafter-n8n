      "id": "find-review",
      "name": "Find Review File",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1160,
        340
      ]
    },
    {
      "parameters": {
        "jsCode": "const names       = $('Match Roster').item.json.matched_names || [$('Match Roster').item.json.matched_name];\nconst emails       = $('Match Roster').item.json.to;\nconst supervisor   = $('Match Roster').item.json.supervisor_name || '';\nconst fullNames    = names.join(' & ');\nconst firstName    = names[0].split(' ')[0];\nconst reviewPath   = $('Find Review File').item.json.path;\nconst paperTitle   = $('Extract Name (GPT)').item.json.paper_title || '';\nconst raw          = $('Get Template').item.json.template;\n\nif (!emails) throw new Error('to empty \u2014 Match Roster: ' + JSON.stringify($('Match Roster').item.json));\n\n// Apply placeholders to raw markdown\nconst filled = raw\n  .replace(/{{name}}/g, firstName)\n  .replace(/{{full_name}}/g, fullNames)\n  .replace(/{{paper_title}}/g, paperTitle)\n  .replace(/{{supervisor}}/g, supervisor);\n\n// Split Subject line from body\nconst lines     = filled.split('\\n');\nconst bodyStart = lines.findIndex(l => l.trim() === '') + 1;\nconst subject   = lines[0].replace(/^Subject:\\s*/i, '').trim();\nconst bodyMd    = lines.slice(bodyStart).join('\\n').trim();\n\nreturn { to: emails, subject, bodyMd, reviewPath, fullNames, paperTitle, supervisor };\n",
        "mode": "runOnceForEachItem"
      },
      "id": "build-email",
      "name": "Build Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        340
      ]
    },
    {
      "parameters": {
        "resource": "draft",
        "operation": "create",
        "subject": "={{ $('Build Email').item.json.subject }}",
        "emailType": "html",
        "message": "={{ $('MD to HTML').item.json.bodyHtml }}",
        "options": {
          "attachmentsUi": {
